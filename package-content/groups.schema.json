{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SteelPermissionGroupsConfig",
  "description": "Permission group configuration schema for Steel",
  "type": "object",
  "properties": {
    "default_groups": {
      "type": "array",
      "description": "Groups applied to every player",
      "items": {
        "$ref": "#/definitions/group_name"
      },
      "uniqueItems": true,
      "default": ["default"]
    },
    "groups": {
      "type": "object",
      "description": "Permission groups keyed by group name",
      "minProperties": 1,
      "required": ["op"],
      "additionalProperties": {
        "$ref": "#/definitions/group"
      }
    }
  },
  "required": ["groups"],
  "additionalProperties": false,
  "definitions": {
    "group_name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "domain_name": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "world_identifier": {
      "type": "string",
      "description": "Namespaced loaded world id such as lobby:spawn",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$"
    },
    "permission_key": {
      "type": "string",
      "description": "Dotted permission key. Only a full trailing segment may be a wildcard.",
      "pattern": "^(\\*|[a-z0-9_-]+(\\.[a-z0-9_-]+)*(\\.\\*)?)$"
    },
    "permission_value_key": {
      "type": "string",
      "description": "Namespaced permission metadata key.",
      "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*:[a-z0-9_-]+([./][a-z0-9_-]+)*$"
    },
    "permission_value": {
      "description": "Typed permission metadata value",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "description": "Permission keys explicitly allowed by this group",
          "items": {
            "$ref": "#/definitions/permission_key"
          },
          "uniqueItems": true,
          "default": []
        },
        "deny": {
          "type": "array",
          "description": "Permission keys explicitly denied by this group",
          "items": {
            "$ref": "#/definitions/permission_key"
          },
          "uniqueItems": true,
          "default": []
        },
        "rules": {
          "type": "array",
          "description": "Structured permission rules with optional contexts",
          "items": {
            "$ref": "#/definitions/rule"
          },
          "default": []
        },
        "values": {
          "type": "array",
          "description": "Structured permission values with optional contexts",
          "items": {
            "$ref": "#/definitions/value_rule"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/permission_key"
        },
        "state": {
          "type": "string",
          "enum": ["allow", "deny"]
        },
        "context": {
          "$ref": "#/definitions/rule_context"
        }
      },
      "required": ["key", "state"],
      "additionalProperties": false
    },
    "value_rule": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/permission_value_key"
        },
        "value": {
          "$ref": "#/definitions/permission_value"
        },
        "context": {
          "$ref": "#/definitions/rule_context"
        }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    },
    "rule_context": {
      "type": "object",
      "description": "Rule-side context where this permission applies. Declare at most one selector.",
      "properties": {
        "domain": {
          "$ref": "#/definitions/domain_name"
        },
        "world": {
          "$ref": "#/definitions/world_identifier"
        },
        "custom": {
          "$ref": "#/definitions/custom_context"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "custom_context": {
      "type": "object",
      "description": "Plugin or subsystem-defined permission context",
      "properties": {
        "key": {
          "$ref": "#/definitions/group_name"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["key", "value"],
      "additionalProperties": false
    }
  }
}
